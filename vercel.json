{
  "functions": {
    "api/parse-list.js": {
      "maxDuration": 60
    },
    "api/read-prices.js": {
      "maxDuration": 300
    },
    "api/submit-receipt.js": {
      "maxDuration": 300,
      "includeFiles": "{prices.csv,stores.json}"
    },
    "api/prices.js": {
      "includeFiles": "prices.csv"
    }
  },
  "redirects": [
    {
      "source": "/prices.csv",
      "destination": "/list.html",
      "permanent": false
    }
  ]
}
